{
  "$schema": "https://github.com/ardelperal/APAP_WEB/tree/main/coolify/apap-local-backend.json",
  "name": "apap-local-backend",
  "project_uuid": "mjgxwv4srqlsuww4pfpyo0t7",
  "environment_uuid": "c7wgl2dmapown2x84f1gbgl9",
  "build_pack": "dockerfile",
  "dockerfile_location": "docker/local-backend.Dockerfile",
  "image": "ghcr.io/ardelperal/apap_web/local-backend:1.0.0",
  "ports_exposes": 8080,
  "ports_mappings": null,
  "health_check_path": "/healthz",
  "health_check_port": 8080,
  "health_check_interval_seconds": 5,
  "health_check_retries": 10,
  "health_check_timeout_seconds": 3,
  "health_check_method": "GET",
  "health_check_return_code": 200,
  "health_check_scheme": "http",
  "health_check_start_period": 20,
  "health_check_type": "http",
  "custom_docker_run_options": "--network=coolify",
  "restart_policy": "unless-stopped",
  "env": {
    "APAP_LOCAL_BACKEND_DSN": "postgresql://postgres:postgres@apap-pg-test:5432/postgres",
    "APAP_LOCAL_BACKEND_OAUTH_CONFIGURED": "false",
    "APAP_INITIAL_ADMIN_EMAIL": "ardelperal@gmail.com"
  }
}
