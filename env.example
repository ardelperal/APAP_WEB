# Required:
APAP_SESSION_SECRET=change-me-to-a-random-64-char-string
APAP_INITIAL_ADMIN_EMAIL=admin@apap.local
APAP_DB_PASSWORD=change-me
# MinIO (S3-compatible storage):
APAP_S3_ACCESS_KEY=minioadmin
APAP_S3_SECRET_KEY=minioadmin
APAP_S3_BUCKET=apap-photos
# Optional (real Google OAuth):
# APAP_GOOGLE_CLIENT_ID=your-client-id
# APAP_GOOGLE_CLIENT_SECRET=your-client-secret
# APAP_PUBLIC_BASE_URL=https://your-public-url
