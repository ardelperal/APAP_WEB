# APAP_WEB — Production environment template
#
# Operators copy this file to .env and edit values. The app never reads
# .env.example. See docs/production-env.md for the operator reference
# and docs/runbooks/coolify-deploy.md for the deploy checklist.
#
# Each block has a Default line and a Production required: yes/no line.
# StartupConfigError fires for required-but-missing values.

# === 1. InsForge (data, auth, storage) =====================================
# Base URL of the InsForge service. Operator override that wins
# unconditionally (see app/core/insforge_url.py::resolve_insforge_url).
APAP_INSFORGE_URL=
# Default: http://localhost:7130
# Production required: yes

# Public anonymous key (browser-side reads). Empty disables unauthenticated
# access from the client; safe to leave empty when the service key does
# all server-side work.
APAP_INSFORGE_ANON_KEY=
# Default: ""
# Production required: no

# Privileged service key used to run admin SQL (create the
# `usuarios_autorizados` table, seed the bootstrap admin, etc.).
# StartupConfigError(APAP_INSFORGE_SERVICE_KEY, "empty") fires when this
# is empty and APAP_DEBUG is false.
APAP_INSFORGE_SERVICE_KEY=
# Default: ""
# Production required: yes

# === 2. Google OAuth =======================================================
# Google OAuth 2.0 client ID registered with the protective's GCP project.
APAP_GOOGLE_CLIENT_ID=
# Default: ""
# Production required: yes

# Google OAuth 2.0 client secret paired with the client ID.
APAP_GOOGLE_CLIENT_SECRET=
# Default: ""
# Production required: yes

# Callback URL registered with Google; must match exactly.
APAP_GOOGLE_REDIRECT_URI=
# Default: http://127.0.0.1:8000/auth/callback
# Production required: yes

# === 3. Session ============================================================
# HMAC secret used to sign session cookies. StartupConfigError fires
# when this equals the placeholder string or is shorter than 32 chars
# and APAP_DEBUG is false (see app/core/config.py::_validate_secrets).
APAP_SESSION_SECRET=
# Default: dev-only-change-me-in-production
# Production required: yes

# === 4. Bootstrap / RBAC ===================================================
# Email of the first developer user, seeded on first startup when no
# developer exists. Empty means "do not seed anyone".
APAP_INITIAL_ADMIN_EMAIL=
# Default: ""
# Production required: no

# === 5. CSRF ===============================================================
# Feature flag for app/core/csrf.py::CsrfMiddleware. When false, the
# middleware short-circuits and emits a csrf.disabled warning per
# request. Production MUST keep this True.
APAP_CSRF_ENABLED=
# Default: true
# Production required: yes

# === 6. Rate limiting ======================================================
# Master feature flag for app/core/rate_limit.py. When false, the
# middleware short-circuits on every request.
APAP_RATE_LIMIT_ENABLED=
# Default: true
# Production required: yes

# OAuth callback bucket size (IP-only, requests per minute).
APAP_RATE_LIMIT_OAUTH_PER_MIN=
# Default: 10
# Production required: yes

# Write bucket size for authenticated users (requests per minute).
APAP_RATE_LIMIT_WRITE_PER_MIN_USER=
# Default: 60
# Production required: yes

# Write bucket size per source IP (requests per minute).
APAP_RATE_LIMIT_WRITE_PER_MIN_IP=
# Default: 30
# Production required: yes

# Whether to trust the X-Forwarded-For header (required when behind a
# reverse proxy). Set to true ONLY behind a trusted proxy; spoofable
# otherwise.
APAP_TRUST_XFF=
# Default: false
# Production required: yes

# === 7. Auth cache =========================================================
# TTL (seconds) for the in-process authorization cache backing
# require_authorized_user. Set to 0 to disable the cache for immediate
# revocation (one extra SELECT per authenticated request).
APAP_AUTH_CACHE_TTL_SECONDS=
# Default: 300
# Production required: no

# Auth-cache backend selector. The Literal["in_process"] guard in
# app/core/config.py rejects any other value at startup; pydantic
# validation fails fast before the first request is served.
APAP_AUTH_CACHE_BACKEND=
# Default: in_process
# Production required: no

# === 8. Logging ============================================================
# Root log level for the JSON stdout handler installed by
# app.core.logging.configure_logging.
APAP_LOG_LEVEL=
# Default: INFO
# Production required: no

# Debug mode bypasses StartupConfigError checks and enables verbose
# traces. Production MUST leave this false.
APAP_DEBUG=
# Default: false
# Production required: yes

# Runtime mode ("web" or "test"). When "test", the rate-limit middleware
# short-circuits without consuming budget. Production MUST be "web".
APAP_MODE=
# Default: web
# Production required: yes

# === 9. E2E (test-only OAuth mock) =========================================
# When true, app.core.e2e_auth.register_e2e_auth_routes registers
# POST /e2e/login which mints a session directly when the X-E2E-Secret
# header matches APAP_E2E_AUTH_SECRET. Production MUST leave this off
# (the route is not registered otherwise and the existing /login 503
# behaviour stands).
APAP_E2E_AUTH_ENABLED=
# Default: false
# Production required: no

# Shared secret the Playwright suite sends in the X-E2E-Secret header.
APAP_E2E_AUTH_SECRET=
# Default: ""
# Production required: no

# Email used by the Playwright conftest when authenticating against the
# mock route. Must exist as a `usuarios_autorizados` row in production.
APAP_E2E_AUTH_DEFAULT_EMAIL=
# Default: e2e@apap.local
# Production required: no

# === 10. M1 magic-link email (SMTP relay) =============================
# Outbound SMTP server used by the magic-link flow. Production MUST point
# at a real relay (Resend, Mailgun, SendGrid, Brevo, or a self-hosted
# Postfix). The free MailDev container in .env is dev-only — emails
# stay inside the test network.
#
# Resend (recommended for APAP — 3k/month free, modern API):
#   1. Create an account at https://resend.com (GitHub login, no card)
#   2. Settings → API Keys → Create (copy the key once — Resend won't
#      show it again)
#   3. Domains → Add Domain → "romancaba.com" → add the SPF + DKIM
#      records Resend gives you to your DNS for romancaba.com
#   4. Wait for verification (a few minutes to a few hours), then
#      "From" can be anything@romancaba.com
APAP_SMTP_HOST=
# Default: smtp.resend.com
# Production required: yes (when APAP_AUTH_ENABLE_MAGIC_LINK=true)
APAP_SMTP_PORT=
# Default: 465
# Production required: no
APAP_SMTP_USER=
# Default: resend
# Production required: no (Resend uses "resend" regardless of API key)
APAP_SMTP_PASSWORD=
# This is the Resend API key (or your relay's password)
# Production required: yes (when APAP_AUTH_ENABLE_MAGIC_LINK=true)
APAP_SMTP_FROM=
# Default: noreply@romancaba.com
# Production required: yes (when APAP_AUTH_ENABLE_MAGIC_LINK=true)
# Set to your verified Resend domain email above

# Local dev only (don't use in production):
#
# APAP_E2E_STUB_AUTH: when set to "true", the lifespan wires an in-memory
# StubAuthPort that returns the operator's bootstrap admin email
# (APAP_INITIAL_ADMIN_EMAIL) for any get_user_by_email call. Production MUST
# leave this unset so the lifespan uses the real InsForge adapter. Dev / CI
# can set it to keep the magic-link round-trip testable without a live
# InsForge user table. Triggers tests/e2e/test_magic_link_e2e.py to pass
# end-to-end against the deployed app.
APAP_E2E_STUB_AUTH=
APAP_USE_MAILDEV=
# Set to "true" to bypass SMTP and route magic-link emails to the
# apap-smtp-dev MailDev container on the docker network. Free,
# anonymous, perfect for E2E tests.

# === 12. M0 local backend (POST-M0, MONITORING-ONLY) =======================
# Master switch that activates the local FastAPI backend subprocess
# (see app/core/insforge_url.py and app/core/local_backend/app.py).
# Production MUST set this to false; the magic-link flow on production
# is verified via InsForge production per
# migration.verify_fallback_ready.check_web_to_legacy_check_only.
APAP_LOCAL_BACKEND=
# Default: false
# Production required: no

# PostgreSQL DSN for the local-backend subprocess (used only when
# APAP_LOCAL_BACKEND=true).
APAP_LOCAL_DB_URL=
# Default: ""
# Production required: no

# Postgres schema name for the local-backend subprocess. Empty means
# the default search_path.
APAP_LOCAL_DB_SCHEMA=
# Default: ""
# Production required: no

# Local InsForge URL the subprocess listens on. Distinct from
# APAP_INSFORGE_URL (which is the production InsForge override).
APAP_INSFORGE_URL_OVERRIDE=
# Default: http://localhost:8000
# Production required: no

# SMTP host for SMTPMailTransport (M1.5 placeholder; M1 wires the
# resolver at app/core/auth_magic/get_mail_transport.py but the actual
# SMTP send is out of scope until M1.5).
APAP_SMTP_HOST=
# Default: ""
# Production required: no

# SMTP port paired with APAP_SMTP_HOST.
APAP_SMTP_PORT=
# Default: 587
# Production required: no

# SMTP authentication user paired with APAP_SMTP_HOST.
APAP_SMTP_USER=
# Default: ""
# Production required: no

# SMTP authentication password paired with APAP_SMTP_USER.
APAP_SMTP_PASSWORD=
# Default: ""
# Production required: no

# From address used by SMTPMailTransport when sending the magic-link
# email.
APAP_SMTP_FROM=
# Default: noreply@apap.local
# Production required: no

# Base URL injected into magic-link emails by the ConsoleMailTransport
# (local dev only; see app/core/local_backend/app.py).
APAP_APP_BASE_URL=
# Default: ""
# Production required: no

# === 11. M1 magic-link (POST-M1, MONITORING-ONLY) ==========================
# Feature flag that registers POST /auth/magic/start + verify routes
# (see app/core/auth_magic/routes.py). Production MUST set this to
# false until M1.5 ships the SMTP wiring; the SMTPMailTransport
# placeholder raises NotImplementedError today.
APAP_AUTH_ENABLE_MAGIC_LINK=
# Default: false
# Production required: no
