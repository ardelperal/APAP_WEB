# Build context trim for both apap-web and the new local-backend Dockerfiles.
# Keeps image rebuilds fast and context uploads small.

# VCS / IDE
.git/
.gitattributes
.idea/
.vscode/

# Local Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.tailwindcss-cache/

# OS / editor cruft
.DS_Store
*.swp
*.swo

# Tests (don't ship in the runtime image; tests live outside the runtime graph)
tests/
openspec/

# Docs (not needed in the runtime)
docs/
*.md
!docker/local-backend.Dockerfile

# Local config / secrets
.env
.env.*
!.env.example
*.log
logs/

# GitHub
.github/

# Build artifacts
dist/
build/
*.egg-info/
