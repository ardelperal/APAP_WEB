# Files and directories excluded from the Docker build context.
# Kept small and explicit so `docker build` stays fast and the
# resulting images stay clean.

.git/
.github/
.gitignore

.venv/
venv/
env/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.egg

.dysflow/
.atl/
.playwright-mcp/
.engram/

# Tailwind dependencies are reproduced from the committed lockfile.
tailwindcss/node_modules/

# Local Access binaries and project documentation that is not needed at
# runtime.
*.accdb
*.laccdb
*.mdb
*.ldb

docs/discovery/
docs/legacy-*.md
docs/mockups/
# `docs/setup.md` is referenced by `pyproject.toml` as the package README,
# so `pip wheel` requires it to exist in the build context. Keep it.
# docs/setup.md
docs/development.md
docs/plan-completo.md
docs/roadmap.md
docs/features-showcase.html
docs/canonical-logs.md
docs/design-tokens-apap-actual.md
docs/architecture/decisiones-proyecto.md
docs/architecture/decisiones/
docs/architecture/architecture-local-backend-stack.md

openspec/

scripts/

# `tests/` is needed by the builder stage of the Dockerfile:
# `pip wheel` includes tests in the wheel metadata, and the `COPY tests/`
# instruction must succeed. Keep it in the build context.
