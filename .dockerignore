# Git
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.so
.Python
.eggs/
*.egg-info/

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp

# Env files
.env
.env.*
# Exception: env.example is copied for reference
!env.example

# Docs
# docs/ is NOT excluded — the Dockerfile's builder stage copies it so pip wheel
# can resolve the package README. The runtime stage does NOT include docs/.

# Tests
tests/
# tests/ is NOT excluded — some test helpers are imported by app/ modules
# via `if TYPE_CHECKING:` blocks. Excluding tests/ would break those imports.

# Migration (runbooks / standalone scripts not needed in the runtime image)
migration/scripts/
migration/reverse_apply/

# Skill registry (runtime doesn't need agent instructions)
.atl/

# OpenSpec (design docs not needed in runtime)
.openspec/

# Node modules (compiled CSS is already copied from the tailwind-base stage)
tailwindcss/node_modules/

# Misc
.DS_Store
*.md
# Exception: README.md is needed by pip wheel in the builder stage
!README.md
